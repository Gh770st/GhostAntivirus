{
  "manifest_version": 3,
  "name": "GhostAntivirus Browser Protection",
  "version": "3.0.0",
  "description": "Advanced browser protection and security extension by GhostAntivirus",
  "author": "GhostAntivirus Team",
  "homepage_url": "https://ghostantivirus.com",
  
  "permissions": [
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "history",
    "cookies",
    "scripting",
    "notifications"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "GhostAntivirus Protection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}