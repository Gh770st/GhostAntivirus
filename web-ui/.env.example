# GhostAntivirus Web Dashboard - Environment Variables

# API URLs
VITE_API_URL=http://localhost:8000
VITE_CORE_URL=http://localhost:9000
VITE_NETWORK_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8000

# Application
VITE_APP_NAME=GhostAntivirus
VITE_APP_VERSION=3.0.0

# Features
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_AUTO_REFRESH=true

# Refresh Intervals (milliseconds)
VITE_STATS_REFRESH_INTERVAL=5000
VITE_CONNECTIONS_REFRESH_INTERVAL=10000

# Development
VITE_DEBUG=false
VITE_LOG_LEVEL=info