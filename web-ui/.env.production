# Production Environment Configuration

# API Endpoints
VITE_CORE_ENGINE_URL=https://api.ghostantivirus.com
VITE_AI_ENGINE_URL=https://ai.ghostantivirus.com
VITE_NETWORK_GUARD_URL=https://network.ghostantivirus.com

# WebSocket
VITE_WS_URL=wss://api.ghostantivirus.com/ws

# Feature Flags
VITE_ENABLE_AI=true
VITE_ENABLE_NETWORK_GUARD=true
VITE_ENABLE_VPN=true
VITE_ENABLE_CRYPTO_VAULT=true

# Refresh Intervals (milliseconds)
VITE_SCAN_STATS_REFRESH=10000
VITE_THREAT_REFRESH=30000
VITE_NETWORK_REFRESH=5000
VITE_SYSTEM_STATS_REFRESH=5000

# Debug
VITE_DEBUG=false
VITE_LOG_LEVEL=error

# Authentication
VITE_JWT_EXPIRY=3600
VITE_REFRESH_TOKEN_EXPIRY=86400